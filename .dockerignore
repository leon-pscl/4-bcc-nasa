.git
.gitignore
.dockerignore

# environment
.env
.env.*

# dependencies / build outputs (rebuilt in image)
node_modules
frontend/node_modules
frontend/dist
frontend/*.tsbuildinfo
frontend/.vite

# data & caches (never COPYed; keeps the build context small)
data/
.tmp/
**/__pycache__
*.pyc
.venv/
venv/

# docs not needed for build
docs

# editors / agents
.claude
.vscode
.idea
